rules_version = '2';

// Reglas de seguridad de Mi Ruta.
//
// Resumen:
//   - Cualquiera puede crear su cuenta, que queda «pendiente» y sin cursos.
//   - Un relator o administrador aprueba cuentas, habilita cursos y emite constancias.
//   - Solo un administrador cambia roles.
//   - Cada persona escribe solo su propio avance, y solo con la cuenta activa.
//   - Las notas personales (bitácora, plantillas) son privadas: nadie más las lee.
//   - Las constancias se pueden verificar con su código, sin iniciar sesión.
//   - Las imágenes de la portada las ve cualquiera y solo las cambia un administrador.
//   - El muro de cada formación lo leen y escriben sus inscritos y el equipo.
//   - Las presentaciones en video las ve su autor y el equipo; solo el equipo las evalúa.
//   - La agenda de cada formación la ven sus inscritos; la edita el equipo.
//   - Las cuentas activas ven quiénes participan en cada formación y pueden escribirse mensajes privados.
//   - El propedéutico «Llamados» está abierto a toda cuenta activa, sin inscripción.
//   - Plazos: 1 semana para empezar y 2 meses para completar (por módulo en los cursos). La propia
//     cuenta y el equipo aplican la regla; la persona solo puede quitar cursos vencidos, nunca agregarlos.
//   - Cualquier cuenta puede enviar sugerencias o reportar problemas; solo la administración las lee y responde.

service cloud.firestore {
  match /databases/{database}/documents {

    function administradoresIniciales() {
      return ['iperezconus84@gmail.com'];
    }

    function conSesion() {
      return request.auth != null;
    }

    function correoVerificado() {
      return conSesion() && request.auth.token.email != null
        && (request.auth.token.email_verified == true
            || request.auth.token.firebase.sign_in_provider == 'google.com');
    }

    function esAdminInicial() {
      return correoVerificado() && request.auth.token.email.lower() in administradoresIniciales();
    }

    function miCuenta() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function tengoCuenta() {
      return conSesion() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function activo() {
      return tengoCuenta() && miCuenta().estado == 'activo';
    }

    function esAdmin() {
      return (activo() && miCuenta().rol == 'admin') || esAdminInicial();
    }

    function esEquipo() {
      return (activo() && miCuenta().rol in ['relator', 'admin']) || esAdminInicial();
    }

    function soloCambia(campos) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos);
    }

    function textoCorto(campo, max) {
      return request.resource.data[campo] is string && request.resource.data[campo].size() <= max;
    }

    // ---------- usuarios ----------
    match /usuarios/{uid} {
      allow get: if conSesion() && (request.auth.uid == uid || esEquipo());
      allow list: if esEquipo();

      // Cada persona crea su propia cuenta: pendiente, como participante y sin cursos.
      // Los administradores iniciales se crean activos.
      allow create: if conSesion() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nombre', 'correo', 'comunidad', 'rol', 'estado', 'cursos', 'solicitudes', 'creado', 'ultimoIngreso'])
        && request.resource.data.correo == request.auth.token.email
        && textoCorto('nombre', 120) && textoCorto('comunidad', 160)
        && request.resource.data.cursos == []
        && request.resource.data.solicitudes is list && request.resource.data.solicitudes.size() <= 30
        && (
          (request.resource.data.rol == 'participante' && request.resource.data.estado == 'pendiente')
          || (esAdminInicial() && request.resource.data.rol == 'admin' && request.resource.data.estado == 'activo')
        );

      allow update: if
        // La persona edita su nombre, comunidad y solicitudes de inscripción.
        (conSesion() && request.auth.uid == uid
          && soloCambia(['nombre', 'comunidad', 'solicitudes', 'ultimoIngreso'])
          && textoCorto('nombre', 120) && textoCorto('comunidad', 160)
          && request.resource.data.solicitudes is list && request.resource.data.solicitudes.size() <= 30)
        // La persona deja formaciones (vencidas, anuladas o por baja voluntaria): solo puede quitar cursos y fechas,
        // nunca agregarlos ni cambiarlos. El contador de anulaciones seguidas solo sube, o vuelve a 0 al empezar una formación.
        || (conSesion() && request.auth.uid == uid
          && soloCambia(['cursos', 'inscripciones', 'vencidos', 'anulaciones'])
          && request.resource.data.get('anulaciones', 0) is int
          && (request.resource.data.get('anulaciones', 0) == 0 || request.resource.data.get('anulaciones', 0) >= resource.data.get('anulaciones', 0))
          && request.resource.data.cursos is list && request.resource.data.cursos.hasOnly(resource.data.cursos)
          && request.resource.data.get('inscripciones', {}).diff(resource.data.get('inscripciones', {})).addedKeys().size() == 0
          && request.resource.data.get('inscripciones', {}).diff(resource.data.get('inscripciones', {})).changedKeys().size() == 0
          && request.resource.data.get('vencidos', {}).diff(resource.data.get('vencidos', {})).addedKeys().size() == 0
          && request.resource.data.get('vencidos', {}).diff(resource.data.get('vencidos', {})).changedKeys().size() == 0)
        // Un relator aprueba, pausa e inscribe a participantes (no cambia roles ni toca a otros relatores).
        || (esEquipo() && !esAdmin() && resource.data.rol == 'participante'
          && soloCambia(['estado', 'cursos', 'solicitudes', 'inscripciones', 'vencidos', 'anulaciones'])
          && request.resource.data.estado in ['pendiente', 'activo', 'pausado'])
        // Un administrador puede todo, salvo dejar un rol o estado inválido.
        || (esAdmin()
          && request.resource.data.rol in ['participante', 'relator', 'admin']
          && request.resource.data.estado in ['pendiente', 'activo', 'pausado']);

      allow delete: if esAdmin();
    }

    // ---------- avance ----------
    // datos: { "hechas:<curso>": [...], "eval:<curso>:<id>": {...} }
    match /avance/{uid} {
      allow read: if conSesion() && (request.auth.uid == uid || esEquipo());
      allow create, update: if conSesion() && request.auth.uid == uid && activo()
        && request.resource.data.keys().hasOnly(['datos', 'actualizado']);
      allow delete: if esAdmin();
    }

    // ---------- notas personales (privadas) ----------
    match /notas/{uid} {
      allow read: if conSesion() && request.auth.uid == uid;
      allow create, update: if conSesion() && request.auth.uid == uid && activo()
        && request.resource.data.keys().hasOnly(['datos']);
      allow delete: if conSesion() && request.auth.uid == uid;
    }

    // ---------- imágenes de las tarjetas de la portada ----------
    // Cualquiera las ve; solo un administrador las cambia (imagen comprimida, máx. ~300 KB).
    match /tarjetas/{id} {
      allow read: if true;
      allow write: if esAdmin()
        && request.resource.data.keys().hasOnly(['imagen', 'actualizado', 'por', 'velo'])
        && (!('velo' in request.resource.data) || (request.resource.data.velo is number && request.resource.data.velo >= 0 && request.resource.data.velo <= 0.9))
        && request.resource.data.get('imagen', '') is string
        && request.resource.data.get('imagen', '').size() <= 300000
        && (request.resource.data.get('imagen', '') == '' || request.resource.data.get('imagen', '').matches('^data:image/(webp|jpeg|png);base64,.*'));
    }

    // ---------- muro de cada formación ----------
    // «llamados» es el propedéutico: abierto a toda cuenta activa, sin inscripción.
    function inscrito(curso) {
      return activo() && (curso == 'llamados' || curso in miCuenta().cursos);
    }
    match /foros/{curso} {
      // Configuración del muro: la ven quienes participan en la formación; la edita el equipo.
      allow read: if esEquipo() || inscrito(curso);
      allow write: if esEquipo()
        && request.resource.data.keys().hasOnly(['bienvenida', 'directrices', 'obligatorio', 'preguntas', 'video', 'consignas', 'actualizado', 'por']);

      match /mensajes/{id} {
        allow read: if esEquipo() || inscrito(curso);
        allow create: if (esEquipo() || inscrito(curso))
          && request.resource.data.keys().hasOnly(['hilo', 'texto', 'uid', 'nombre', 'rol', 'creado', 'borrado'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.hilo is string && request.resource.data.hilo.size() <= 80
          && request.resource.data.texto is string && request.resource.data.texto.size() > 0 && request.resource.data.texto.size() <= 3000
          && request.resource.data.borrado == false;
        // Quien escribió puede borrar su mensaje; el equipo puede borrar cualquiera (queda como «mensaje eliminado»).
        allow update: if (resource.data.uid == request.auth.uid || esEquipo())
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['borrado', 'texto'])
          && request.resource.data.borrado == true && request.resource.data.texto == '';
        allow delete: if esAdmin();
      }

      // Agenda de la formación: la ven sus inscritos y el equipo; la edita el equipo.
      match /agenda/{id} {
        allow read: if esEquipo() || inscrito(curso);
        allow write: if esEquipo()
          && request.resource.data.keys().hasOnly(['titulo', 'fecha', 'hora', 'tipo', 'detalle', 'borrado', 'por'])
          && request.resource.data.titulo is string && request.resource.data.titulo.size() > 0 && request.resource.data.titulo.size() <= 140
          && request.resource.data.fecha is string && request.resource.data.fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.detalle is string && request.resource.data.detalle.size() <= 1000;
      }
    }

    // ---------- directorio de participantes ----------
    // Cada persona publica su nombre, comunidad, rol y cursos; lo ven las cuentas activas (lista de participantes).
    match /presencia/{uid} {
      allow read: if activo();
      allow write: if activo() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nombre', 'comunidad', 'rol', 'cursos'])
        && request.resource.data.rol == miCuenta().rol
        && request.resource.data.cursos == miCuenta().cursos
        && request.resource.data.nombre == miCuenta().nombre;
    }

    // ---------- mensajería entre personas ----------
    // Id: «uidA__uidB» (ordenados). Solo las dos personas leen y escriben.
    match /conversaciones/{id} {
      allow get: if activo() && id.matches('.*' + request.auth.uid + '.*');
      allow list: if activo() && request.auth.uid in resource.data.participantes;
      allow create: if activo()
        && request.resource.data.keys().hasOnly(['participantes', 'nombres', 'actualizado', 'leido'])
        && request.resource.data.participantes.size() == 2
        && request.auth.uid in request.resource.data.participantes
        && id == request.resource.data.participantes[0] + '__' + request.resource.data.participantes[1];
      allow update: if activo() && request.auth.uid in resource.data.participantes
        && request.resource.data.participantes == resource.data.participantes
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ultimo', 'actualizado', 'leido']);

      match /mensajes/{msg} {
        allow read: if activo() && request.auth.uid in get(/databases/$(database)/documents/conversaciones/$(id)).data.participantes;
        allow create: if activo() && request.auth.uid in get(/databases/$(database)/documents/conversaciones/$(id)).data.participantes
          && request.resource.data.keys().hasOnly(['uid', 'texto', 'creado'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.texto is string && request.resource.data.texto.size() > 0 && request.resource.data.texto.size() <= 2000;
      }
    }

    // ---------- presentaciones finales en video ----------
    // Id del documento: «curso~módulo~uid». Cada participante envía su enlace de YouTube; el equipo lo evalúa con la rúbrica.
    function enlaceYoutube(url) {
      return url is string && url.size() <= 300 && url.matches('^https://(www[.]|m[.])?(youtube[.]com|youtu[.]be)/.+');
    }
    match /entregas/{id} {
      allow get: if conSesion() && (esEquipo() || id.matches('.*~' + request.auth.uid));
      allow list: if esEquipo();
      allow create: if conSesion() && request.resource.data.uid == request.auth.uid
        && (esEquipo() || inscrito(request.resource.data.curso))
        && id == request.resource.data.curso + '~' + request.resource.data.modulo + '~' + request.auth.uid
        && request.resource.data.keys().hasOnly(['curso', 'modulo', 'uid', 'nombre', 'url', 'comentario', 'enviado'])
        && enlaceYoutube(request.resource.data.url)
        && request.resource.data.comentario is string && request.resource.data.comentario.size() <= 1000;
      allow update: if
        // El participante cambia su enlace o comentario (no toca la evaluación).
        (conSesion() && resource.data.uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['url', 'comentario', 'enviado', 'nombre'])
          && enlaceYoutube(request.resource.data.url)
          && request.resource.data.comentario is string && request.resource.data.comentario.size() <= 1000)
        // El equipo registra la evaluación con la rúbrica.
        || (esEquipo() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['evaluacion']));
      allow delete: if esAdmin();
    }

    // ---------- sugerencias y problemas (canal con la administración) ----------
    // Cualquier persona con cuenta escribe; ve solo lo suyo. La administración lee todo y responde.
    match /soporte/{id} {
      allow create: if conSesion() && tengoCuenta()
        && request.resource.data.keys().hasOnly(['uid', 'nombre', 'correo', 'rol', 'tipo', 'texto', 'pagina', 'estado', 'respuesta', 'creado'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.tipo in ['mejora', 'error', 'contenido', 'otro']
        && request.resource.data.texto is string && request.resource.data.texto.size() >= 5 && request.resource.data.texto.size() <= 2000
        && request.resource.data.pagina is string && request.resource.data.pagina.size() <= 300
        && textoCorto('nombre', 120) && textoCorto('correo', 200) && textoCorto('rol', 20)
        && request.resource.data.estado == 'nuevo' && request.resource.data.respuesta == ''
        && request.resource.data.creado == request.time;
      allow get: if conSesion() && (resource.data.uid == request.auth.uid || esAdmin());
      allow list: if conSesion() && (resource.data.uid == request.auth.uid || esAdmin());
      allow update: if esAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'respuesta', 'respondido', 'respondidoPor'])
        && request.resource.data.estado in ['nuevo', 'revision', 'resuelto', 'descartado']
        && request.resource.data.respuesta is string && request.resource.data.respuesta.size() <= 2000;
      allow delete: if esAdmin();
    }

    // ---------- constancias ----------
    match /constancias/{folio} {
      // Cualquiera puede verificar una constancia si conoce su código.
      allow get: if true;
      // El equipo ve todas; cada persona, las suyas.
      allow list: if esEquipo() || (conSesion() && resource.data.uid == request.auth.uid);
      allow create: if esEquipo()
        && request.resource.data.folio == folio
        && request.resource.data.emitidaPor == request.auth.uid
        && request.resource.data.uid is string
        && exists(/databases/$(database)/documents/usuarios/$(request.resource.data.uid));
      allow update: if false;
      allow delete: if esAdmin();
    }
  }
}
